{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "ignoreCommand": "base=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\"; if git cat-file -e \"$base^{commit}\" 2>/dev/null && git diff --quiet \"$base\" HEAD -- .; then exit 0; else exit 1; fi",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/github", "destination": "https://github.com/sudo-py-dev/reclaim", "permanent": false },
    { "source": "/releases", "destination": "https://github.com/sudo-py-dev/reclaim/releases/latest", "permanent": false },
    { "source": "/dl/windows", "destination": "https://github.com/sudo-py-dev/reclaim/releases/latest/download/reclaim-windows-x86_64-setup.exe", "permanent": false },
    { "source": "/dl/macos-arm", "destination": "https://github.com/sudo-py-dev/reclaim/releases/latest/download/reclaim-macos-aarch64.pkg", "permanent": false },
    { "source": "/dl/macos-intel", "destination": "https://github.com/sudo-py-dev/reclaim/releases/latest/download/reclaim-macos-x86_64.pkg", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
