---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import Icon from './Icon.astro';
import { useDict, type Locale } from '../i18n';

/**
 * A desktop window frame around a screenshot, with a title bar in the page's
 * language. Clicking it opens the screenshot full size (see Lightbox).
 */
interface Props {
  locale: Locale;
  zoom?: boolean;
  class?: string;
}

const { locale, zoom = true, class: className } = Astro.props;
const t = useDict(locale);
---

<figure class:list={['window', className]}>
  <div class="titlebar" aria-hidden="true">
    <Image src={appIcon} alt="" width={14} height={14} densities={[1, 2]} />
    <span>{t.ui.windowTitle}</span>
    <i class="controls"><b></b><b></b><b></b></i>
  </div>
  <div class="viewport">
    <slot />
    {
      zoom && (
        <button type="button" class="zoom" data-zoom aria-label={t.ui.zoom}>
          <Icon name="plus" size={18} />
        </button>
      )
    }
  </div>
</figure>

<style>
  .window {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--frame-line);
    border-radius: 14px;
    background: var(--frame-bg);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding-inline: 12px;
    border-bottom: 1px solid var(--frame-line);
    background: var(--frame-bar);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    user-select: none;
  }

  .titlebar span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .controls {
    display: flex;
    gap: 14px;
    margin-inline-start: auto;
    font-style: normal;
  }

  .controls b {
    display: block;
    width: 9px;
    height: 9px;
    border: 1.5px solid currentColor;
    border-radius: 2px;
    opacity: 0.45;
  }

  .controls b:first-child {
    height: 0;
    border-width: 1.5px 0 0;
    margin-top: 4px;
  }

  .viewport {
    position: relative;
  }

  .viewport :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .zoom {
    position: absolute;
    inset-inline-end: 10px;
    top: 10px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--ink);
    box-shadow: var(--shadow);
    cursor: zoom-in;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .window:hover .zoom,
  .zoom:focus-visible {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .zoom {
      opacity: 1;
      transform: none;
    }
  }
</style>
